<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MtkNative" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/mtk_primary</item>
        <item name="colorOnPrimary">@color/mtk_on_primary</item>
        <item name="colorPrimaryContainer">@color/mtk_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/mtk_on_primary_container</item>
        <item name="colorSecondary">@color/mtk_secondary</item>
        <item name="colorError">@color/mtk_error</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="TextAppearance.Mtk.Mono" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">monospace</item>
        <item name="android:typeface">monospace</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="Widget.Mtk.ValueLabel" parent="android:Widget.TextView">
        <item name="android:textAppearance">?attr/textAppearanceLabelSmall</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Widget.Mtk.ValueText" parent="android:Widget.TextView">
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="android:fontFamily">monospace</item>
    </style>
</resources>
