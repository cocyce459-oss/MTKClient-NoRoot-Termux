<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="0dp"
            style="?attr/materialCardViewOutlinedStyle">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:text="@string/warning_banner"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorError" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/connectButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="@string/connect" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/disconnectButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:enabled="false"
                android:text="@string/disconnect" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/deviceCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            style="?attr/materialCardViewFilledStyle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/device_identity"
                    android:textAppearance="?attr/textAppearanceTitleSmall" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="8dp">
                    <TextView style="@style/Widget.Mtk.ValueLabel" android:layout_width="96dp"
                        android:layout_height="wrap_content" android:text="@string/label_chip" />
                    <TextView android:id="@+id/chipValue" style="@style/Widget.Mtk.ValueText"
                        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="4dp">
                    <TextView style="@style/Widget.Mtk.ValueLabel" android:layout_width="96dp"
                        android:layout_height="wrap_content" android:text="@string/label_hwcode" />
                    <TextView android:id="@+id/hwcodeValue" style="@style/Widget.Mtk.ValueText"
                        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="4dp">
                    <TextView style="@style/Widget.Mtk.ValueLabel" android:layout_width="96dp"
                        android:layout_height="wrap_content" android:text="@string/label_usb_id" />
                    <TextView android:id="@+id/usbIdValue" style="@style/Widget.Mtk.ValueText"
                        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginTop="4dp">
                    <TextView style="@style/Widget.Mtk.ValueLabel" android:layout_width="96dp"
                        android:layout_height="wrap_content" android:text="@string/label_mode" />
                    <TextView android:id="@+id/modeValue" style="@style/Widget.Mtk.ValueText"
                        android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/memory_read"
            android:textAppearance="?attr/textAppearanceTitleSmall" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/memReadLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                style="?attr/textInputOutlinedStyle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/memAddressInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_address"
                    android:inputType="textNoSuggestions"
                    android:fontFamily="monospace"
                    android:text="0x8000000" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                style="?attr/textInputOutlinedStyle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/memLengthInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_length"
                    android:inputType="textNoSuggestions"
                    android:fontFamily="monospace"
                    android:text="0x10" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/memReadButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/mem_read" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/engine_log"
                android:textAppearance="?attr/textAppearanceTitleSmall" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/clearLogButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/clear_log" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/logScroll"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="4dp"
            android:background="?attr/colorSurfaceVariant"
            android:padding="8dp">

            <TextView
                android:id="@+id/logText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textIsSelectable="true"
                android:textAppearance="@style/TextAppearance.Mtk.Mono" />
        </ScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rebootButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:enabled="false"
            android:textColor="?attr/colorError"
            app:strokeColor="?attr/colorError"
            android:text="@string/reboot" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
